// Cloudflare Pages config (project "portfolio-kc"). The site is a static export:
// `npm run build` writes out/, and Pages serves it as-is.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-kc",
  "compatibility_date": "2026-10-01",
  "pages_build_output_dir": "./out"
}
